{
    "manifest_version": 2,
    "name": "ClassicYT",
    "version": "3.13.1",
    "description": "__MSG_extensionDescription__",
    "default_locale": "en",
    "homepage_url": "https://github.com/andrizan/YouTubeRedux",
    "permissions": ["storage"],
    "optional_permissions": ["downloads"],
    "browser_action": {
      "default_popup": "popup.html",
      "default_icon": {
        "16": "images/16.png",
        "32": "images/32.png",
        "48": "images/48.png",
        "128": "images/128.png"
      }
    },
    "icons": {
      "16": "images/16.png",
      "32": "images/32.png",
      "48": "images/48.png",
      "128": "images/128.png"
    },
    "background": {
      "scripts": ["background.js"],
      "persistent": false
    },
    "content_scripts": [
      {
        "matches": ["*://*.youtube.com/*"],
        "exclude_matches": ["*://*.youtube.com/embed/*"],
        "css": ["styles.css"],
        "js": [
          "helpers/logger.js",
          "helpers/enums.js",
          "helpers/states.js",
          "helpers/i18n.js",
          "helpers/settings.js",
          "initial-setup.js"
        ],
        "run_at": "document_start"
      },
      {
        "matches": ["*://*.youtube.com/*"],
        "exclude_matches": ["*://*.youtube.com/embed/*"],
        "js": ["main.js"]
      }
    ],
    "web_accessible_resources": [
      "images/*"
    ],
    "browser_specific_settings": {
      "gecko": {
        "id": "classicyt@andrizan.github.io",
        "strict_min_version": "140.0",
        "update_url": "https://raw.githubusercontent.com/andrizan/YouTubeRedux/master/updates.json",
        "data_collection_permissions": {
          "required": ["none"]
        }
      },
      "gecko_android": {
        "strict_min_version": "142.0"
      }
    }
  }
